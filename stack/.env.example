# Grafana admin login
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_this_secure_password

# Ports published on the VM. The NSG only allows 3000 and 9090.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# How long Prometheus keeps metrics
PROMETHEUS_RETENTION_TIME=15d

# Only needed with the "database" profile. Leave empty otherwise.
PG_DATA_SOURCE_NAME=

# Where Prometheus and Grafana keep their state.
# On the VM this is the persistent Azure data disk, which survives a rebuild.
# Set it to a local path if you are running the stack somewhere else.
DATA_ROOT=/data
