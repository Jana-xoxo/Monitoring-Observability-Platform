#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git
write_files:
  - path: /usr/local/bin/prepare-data-disk.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      # Prepare the persistent Azure data disk that holds Prometheus and
      # Grafana state. Runs on every boot and every VM rebuild, so it must
      # only ever format a disk that has no filesystem on it.
      set -euo pipefail
      LUN="${data_disk_lun}"
      MOUNT="/data"

      mkdir -p "$MOUNT"

      # Azure presents data disks over SCSI on some VM sizes and over NVMe on
      # others, so neither the device name nor the symlink layout is fixed.
      # by-lun is what the NVMe-backed sizes get, scsi1 is the older SCSI
      # layout. Check both, and resolve the symlink to the real device.
      find_disk() {
        local c
        for c in "/dev/disk/azure/data/by-lun/$LUN" \
                 "/dev/disk/azure/scsi1/lun$LUN"; do
          if [ -e "$c" ]; then readlink -f "$c"; return 0; fi
        done
        return 1
      }

      not_persistent() {
        echo "WARNING: $1"
        echo "Metrics will NOT survive a VM rebuild. $1" > "$MOUNT/.NOT-PERSISTENT"
      }

      REAL=""
      for i in $(seq 1 100); do
        REAL=$(find_disk) && break
        echo "waiting for data disk at lun $LUN ($i/100)"
        sleep 3
      done

      if [ -z "$REAL" ]; then
        # || true because a missing directory makes ls exit non-zero, and
        # pipefail would otherwise kill the script before the marker is written.
        ls -l /dev/disk/azure/data/by-lun /dev/disk/azure/scsi1 2>&1 | head -20 || true
        not_persistent "no data disk at lun $LUN"
      else
        echo "lun $LUN resolves to $REAL"
        # blkid exits non-zero when there is no filesystem, which is how a
        # brand new disk looks. That is the only case where we format.
        if ! blkid "$REAL" >/dev/null 2>&1; then
          echo "no filesystem on $REAL, formatting once"
          mkfs.ext4 -F -L p13data "$REAL"
        else
          echo "existing filesystem found on $REAL, keeping it"
        fi

        UUID=$(blkid -s UUID -o value "$REAL")
        # nofail so a missing disk can never stop the VM from booting.
        if ! grep -q "$UUID" /etc/fstab; then
          echo "UUID=$UUID $MOUNT ext4 defaults,nofail 0 2" >> /etc/fstab
        fi

        # Mount the device directly rather than looking it up in fstab, so
        # this works on the first boot too. A mount that fails quietly is
        # what put the metrics on the OS disk unnoticed, so verify it.
        mountpoint -q "$MOUNT" || mount "$REAL" "$MOUNT" || true
        if mountpoint -q "$MOUNT"; then
          rm -f "$MOUNT/.NOT-PERSISTENT"
        else
          not_persistent "$REAL exists but $MOUNT could not be mounted"
        fi
      fi

      # Container uids, checked against the images:
      #   prom/prometheus runs as nobody  65534:65534
      #   grafana/grafana runs as grafana 472:0
      mkdir -p "$MOUNT/prometheus" "$MOUNT/grafana"
      chown 65534:65534 "$MOUNT/prometheus"
      chown 472:0       "$MOUNT/grafana"
      chmod 755 "$MOUNT/prometheus" "$MOUNT/grafana"

      echo "data disk ready:"
      df -h "$MOUNT" | tail -1
  - path: /usr/local/bin/bootstrap-stack.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      REPO="${repo_url}"
      USER_NAME="${admin_username}"
      HOME_DIR="/home/$USER_NAME"
      if [ -z "$REPO" ]; then
        echo "no repo_url set, skipping auto deploy"
        exit 0
      fi
      if [ ! -d "$HOME_DIR/project13" ]; then
        sudo -u "$USER_NAME" git clone "$REPO" "$HOME_DIR/project13"
      fi
      cat > "$HOME_DIR/project13/stack/.env" <<ENVEOF
      GF_ADMIN_USER=${grafana_admin_user}
      GF_ADMIN_PASSWORD=${grafana_admin_password}
      ENVEOF
      chown "$USER_NAME:$USER_NAME" "$HOME_DIR/project13/stack/.env"
      chmod 600 "$HOME_DIR/project13/stack/.env"
      cd "$HOME_DIR/project13/stack"
      docker compose up -d
  - path: /etc/systemd/system/p13-stack.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Project 13 monitoring stack (data disk + docker compose)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      TimeoutStartSec=0
      ExecStart=/usr/local/bin/prepare-data-disk.sh
      ExecStart=/usr/local/bin/bootstrap-stack.sh
      StandardOutput=journal+console
      StandardError=journal+console

      [Install]
      WantedBy=multi-user.target
runcmd:
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - usermod -aG docker ${admin_username}
  # Detached on purpose. A blocking start holds cloud-init open, Azure never
  # reports the VM provisioned, and Terraform never attaches the data disk.
  - systemctl daemon-reload
  - systemctl enable p13-stack.service
  - systemctl start --no-block p13-stack.service
